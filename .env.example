# Copie para .env e ajuste antes de subir em qualquer ambiente que nao seja o seu localhost.
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=ecommerce

# Minimo 32 caracteres (256 bits) para HS256.
JWT_SECRET=troque-esta-chave-de-desenvolvimento-com-no-minimo-32-chars

# Origens liberadas para o front (lista separada por virgula).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
